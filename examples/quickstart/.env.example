# Your Auth0 tenant domain, e.g. example.us.auth0.com
AUTH0_DOMAIN=
# Credentials of a "Regular Web Application" in the Auth0 Dashboard
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret used to encrypt the session cookie: openssl rand -hex 32
AUTH0_SECRET=
# Optional; inferred from the request host when omitted
APP_BASE_URL=http://localhost:3000
